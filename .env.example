# Zule AI — renderer build-time environment
#
# Copy to `.env` for local development:  cp .env.example .env
# Only VITE_-prefixed vars reach the renderer; Vite inlines them at build
# time, so changing one requires a rebuild.
#
# Firebase client config is NOT here — it is hardcoded in
# src/firebase/config.ts (web API keys are public by design and are
# guarded by Firestore rules plus the Authorized Domains list).
#
# Backend base URL for the Razorpay checkout functions. Optional: packaged
# builds already default to the deployed API, and dev falls back to
# http://localhost:3000 (`vercel dev`). Set this only to point at a
# different deployment, e.g. a preview URL.
VITE_VERCEL_API_URL=https://zuleai.vercel.app

# ---------------------------------------------------------------------
# Server-side only — set these in the Vercel dashboard, NEVER in this
# file or any committed file. Listed for reference.
#
#   FIREBASE_PROJECT_ID
#   FIREBASE_CLIENT_EMAIL
#   FIREBASE_PRIVATE_KEY
#   RAZORPAY_KEY_ID
#   RAZORPAY_KEY_SECRET
#   RAZORPAY_WEBHOOK_SECRET
# ---------------------------------------------------------------------
