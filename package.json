{
  "name": "zule",
  "description": "Desktop Helper Service",
  "author": "Desktop Helper",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --run",
    "fetch:models": "node scripts/fetch-models.mjs",
    "test:e2e": "playwright test",
    "test:coverage": "vitest --run --coverage",
    "ci": "npm run lint && npm run build && npm run test:coverage && npm run test:e2e",
    "electron:dev": "vite --config vite.electron.config.ts",
    "electron:build": "vite build --config vite.electron.config.ts && electron-builder --win",
    "electron:preview": "vite build --config vite.electron.config.ts && electron .",
    "stage-c:overlay:build": "vite build --config vite.stageC.overlay.config.ts",
    "stage-c:probe": "node native/stage-c/toolchain-probe.mjs",
    "stage-c:verify-toolchain": "node native/stage-c/toolchain-probe.mjs --require-available",
    "stage-c:check-schema": "node native/stage-c/scripts/check-schema-parity.mjs",
    "stage-c:build": "node native/stage-c/scripts/check-schema-parity.mjs && node native/stage-c/build-native.mjs",
    "stage-c:package": "node native/stage-c/scripts/check-schema-parity.mjs && node native/stage-c/build-guard.mjs stage-c:package",
    "stage-c:production-enable": "node native/stage-c/scripts/check-schema-parity.mjs && node native/stage-c/build-guard.mjs stage-c:production-enable",
    "stage-c:hash-artifacts": "node scripts/stage-c/artifact-manifest.mjs",
    "stage-c:run-gates": "node scripts/stage-c/run-gates.mjs",
    "stage-c:assemble-evidence": "node scripts/stage-c/assemble-evidence.mjs"
  },
  "overrides": {
    "jose": "4.15.5"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "electron-updater": "^6.8.9",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.1.0",
    "framer-motion": "^12.40.0",
    "hnswlib-node": "^3.0.0",
    "jose": "4.15.5",
    "koffi": "^3.1.4",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.0.227",
    "razorpay": "^2.9.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.49.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vercel/node": "^5.8.22",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "3.2.4",
    "electron": "^42.4.0",
    "electron-builder": "^24.13.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "6.0.0",
    "fast-check": "3.23.2",
    "globals": "^17.6.0",
    "jsdom": "25.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "3.2.4"
  }
}
