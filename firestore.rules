rules_version = '2';

// Zule AI — Firestore Security Rules
//
// Subscription state (`users/{uid}/subscription/current`) is the single
// source of truth for plan entitlement (see src/context/SubscriptionContext.tsx).
// It is written EXCLUSIVELY by trusted server code running the Admin SDK
// (api/razorpayWebhook.ts, api/createRazorpaySubscription.ts), which bypasses
// these rules entirely. Client writes to this path must stay denied — the
// Admin SDK bypass is what makes plan upgrades trustworthy; if these rules
// ever allow a client write here, any signed-in user can self-grant a paid
// plan for free.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      match /subscription/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        // Only the Admin SDK (server) writes subscription state.
        allow write: if false;
      }
    }

    // Idempotency ledger for the Razorpay webhook (api/razorpayWebhook.ts).
    // Server-only; no client should ever read or write this collection.
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
